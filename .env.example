# La base. Es la única variable indispensable: sin ella la app lo dice en vez de
# inventar datos. Nunca se pega en un chat ni se commitea.
DATABASE_URL=postgresql://usuario:contraseña@host:6543/postgres

# --- Cuentas (Supabase Auth) ---
# El proyecto y la llave pública que el NAVEGADOR usa para hablar con el servicio
# de identidad. Son distintas de DATABASE_URL y sí viajan al cliente: la llave
# anónima es pública a propósito y no da acceso a la base.
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Quién administra la plataforma, separado por comas. El admin se declara aquí y
# no se gana por entrar primero.
ADMIN_EMAILS=

# --- Cobro (Stripe) ---
# La secreta NUNCA lleva el prefijo NEXT_PUBLIC_: eso la mandaría al navegador, y
# una llave secreta en el navegador es una llave publicada.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook, para verificar que el aviso de cobro viene de Stripe.
STRIPE_WEBHOOK_SECRET=

# Sólo para scripts y pruebas: el link del correo regresa al dominio por el que
# llegó la petición, así que en la app no hace falta.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tipo de cambio de respaldo cuando no se puede consultar el del día.
# MXN_POR_USD=18.5
