{
  "name": "tcgpool",
  "version": "0.1.0",
  "private": true,
  "description": "Comparador/buscador de cartas TCG en tiendas mexicanas",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:build && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:build": "tsx scripts/build-db.ts",
    "sync": "tsx scripts/sync.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "make-samples": "tsx scripts/make-samples.ts",
    "test": "tsx --test src/lib/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
