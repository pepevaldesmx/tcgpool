{
  "name": "tcgpool",
  "version": "0.1.0",
  "private": true,
  "description": "Comparador/buscador de cartas TCG en tiendas mexicanas",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sync": "tsx --env-file-if-exists=.env.local scripts/sync.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "make-wolf-demo": "tsx scripts/make-wolf-demo.ts",
    "make-samples": "tsx scripts/make-samples.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "snapshots:normalize": "tsx scripts/normalize-snapshots.ts",
    "panel:token": "tsx --env-file-if-exists=.env.local scripts/panel-token.ts",
    "probe": "tsx scripts/probe-store.ts",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke.ts",
    "catalog:seed": "tsx --env-file-if-exists=.env.local scripts/catalog-seed.ts",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/db-check.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/sync.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
